# Homelab image: upstream Hermes Agent + the Claude Code CLI, plus a launcher
# that runs the gateway and dashboard together in ONE container.
#
# The bundled autonomous-ai-agents/claude-code skill drives the `claude`
# binary via the terminal tool, but upstream does not ship it — the image
# seals /opt/hermes read-only and its lazy-install path is Python-only.
# Deriving here is the reproducible way to add an npm CLI to the runtime.
#
# Claude Code credentials live in $HOME/.claude. Pair this image with
# `terminal.home_mode: profile` so tool subprocesses get HOME=/opt/data/home
# on the durable volume, otherwise the login is lost on every redeploy.
#
# homelab-two-service.sh is the container command (set in Dokploy). See the
# header of that script for why s6-overlay cannot be used on titan.
FROM nousresearch/hermes-agent:v2026.8.13

RUN npm install -g @anthropic-ai/claude-code && \
    claude --version

COPY docker/homelab-two-service.sh /opt/hermes/docker/homelab-two-service.sh
RUN chmod +x /opt/hermes/docker/homelab-two-service.sh && \
    bash -n /opt/hermes/docker/homelab-two-service.sh

# Overlay the bounded-.sync.lock fix onto the pinned upstream runtime.
# Upstream's _sync_back_locked() blocks forever on fcntl.flock(LOCK_EX), which
# wedges a gateway turn permanently when a peer sandbox holds the lock — the
# inactivity watchdog cannot interrupt a thread parked in a syscall. Still
# unfixed as of v2026.8.18, so carry it here until upstream takes the patch.
#
# SAFE ONLY WHILE this file is byte-identical between the pinned tag and the
# branch it is copied from — verify with:
#   diff <(git show v2026.8.13:tools/environments/file_sync.py) \
#        tools/environments/file_sync.py
# The py_compile guard below catches a syntax break, not a semantic drift.
COPY tools/environments/file_sync.py /opt/hermes/tools/environments/file_sync.py
RUN python3 -c "import py_compile,sys; py_compile.compile('/opt/hermes/tools/environments/file_sync.py', doraise=True)" && \
    grep -q "LOCK_NB" /opt/hermes/tools/environments/file_sync.py

# edge-tts for Discord voice-channel replies. The upstream image builds with
# `--extra all --extra messaging`, which covers discord.py[voice] (PyNaCl +
# opus bindings) but NOT edge-tts — it lives in its own `[edge-tts]` extra.
# We can't rely on the lazy-install path either: the homelab deployment sets
# HERMES_DISABLE_LAZY_INSTALLS=1, so the package has to be baked in here.
#
# Chosen over the litellm route because litellm serves no TTS model, and over
# OpenAI/ElevenLabs because edge-tts is free, keyless, and ships native
# Afrikaans voices (af-ZA-AdriNeural / af-ZA-WillemNeural) — Hermes runs with
# stt.language: af, so replies should come back in the same voice register.
#
# Version pinned to match pyproject.toml's [edge-tts] extra. The venv has no
# pip (uv-created), so install through uv against that interpreter explicitly.
RUN uv pip install --python /opt/hermes/.venv/bin/python edge-tts==7.2.7 && \
    /opt/hermes/.venv/bin/python -c "import edge_tts; print('edge-tts', edge_tts.__version__)"


# Fix auto-TTS on deployments that set HERMES_WRITE_SAFE_ROOT.
# build_auto_tts_output_path() hardcodes tempfile.gettempdir() (/tmp), but
# text_to_speech_tool() validates output_path via agent.file_safety, which
# denies anything outside HERMES_WRITE_SAFE_ROOT (=/opt/data here). Every
# auto-TTS write is refused, and the adapter checks
# `if tts_data.get("success", True):` with no else and no raise — so the
# playback loop runs zero times and the failure is totally silent. Discord
# voice-channel replies and WhatsApp voice notes both die with no log.
# Redirect the base dir to $HERMES_HOME/audio_cache (inside the safe root).
COPY docker/patch_autotts_safe_path.py /tmp/patch_autotts_safe_path.py
RUN python3 /tmp/patch_autotts_safe_path.py && rm /tmp/patch_autotts_safe_path.py

# Resolve terminal SSH identity from the ACTIVE profile, not the default home.
# gateway/run.py bridges terminal.* from the DEFAULT home's config.yaml into
# process-global TERMINAL_* env vars once at import, and terminal_tool.py reads
# only those. Under gateway.multiplex_profiles every turn already runs in a
# contextvar scope pointing get_hermes_home() at the sender's profile, so the
# per-profile ssh_user/ssh_key/cwd were never reachable: both people inherited
# the default home's deliberate `DISABLED-no-default-profile` / `/dev/null`
# sentinel and every terminal call failed with "Permission denied (publickey)".
# See the patch script header for why raising the sentinel is not a fix.
COPY docker/patch_profile_terminal_config.py /tmp/patch_profile_terminal_config.py
RUN python3 /tmp/patch_profile_terminal_config.py && rm /tmp/patch_profile_terminal_config.py

# Let vision read inbound media that ingest cached under the DEFAULT home.
# _media_cache_roots() derives the permitted-read allowlist from
# get_hermes_home(), which inside a turn is the routed profile's home. But the
# gateway caches inbound photos during message ingest, BEFORE the profile scope
# exists, so they land under the default home. Writer and reader never agree
# under gateway.multiplex_profiles, the read is refused, and the caller falls
# back to an in-sandbox read — the sandbox being hulk over SSH, which has no
# /opt/data. Every photo failed with "not reachable inside the sandbox".
# Adds the default home's media roots and logs a WARNING on every such read so
# the underlying scope bug stays visible instead of silently working.
COPY docker/patch_media_cache_roots.py /tmp/patch_media_cache_roots.py
RUN python3 /tmp/patch_media_cache_roots.py && rm /tmp/patch_media_cache_roots.py

# Let a typed reply answer a pending clarify under gateway.multiplex_profiles.
# The adapter looked the clarify up under the agent:main key while the runner
# registered it under agent:<profile>, so the answer queued behind the blocked
# turn and every WhatsApp chat went silent until the 3600s clarify timeout.
# Upstream fix 525ca9ca1c ships in v2026.8.16; drop this when FROM reaches it.
COPY docker/patch_clarify_bypass_profile_key.py /tmp/patch_clarify_bypass_profile_key.py
RUN python3 /tmp/patch_clarify_bypass_profile_key.py && rm /tmp/patch_clarify_bypass_profile_key.py

# Let a typed WhatsApp message answer a clarify sent as a poll. v2026.8.13
# rejects prose for a poll and queues it behind the very turn waiting on that
# clarify, so the chat still stalled for the 3600s timeout. A WhatsApp poll
# has no "Other" button, so typed text is accepted as the answer. Upstream
# 9bff109783 (v2026.8.16) handles it differently; drop this when FROM reaches it.
COPY docker/patch_whatsapp_clarify_free_text.py /tmp/patch_whatsapp_clarify_free_text.py
RUN python3 /tmp/patch_whatsapp_clarify_free_text.py && rm /tmp/patch_whatsapp_clarify_free_text.py

# Let Swarm replace a frozen gateway. The service had no health check, so a
# gateway whose event loop hung stayed "Running" and nobody got a reply until a
# user complained (2026-09-10, about an hour of silence). The script fails when
# state/gateway.heartbeat is older than 90s. Worst case from freeze to a new
# task: 90s stale + 4 failed checks x 30s + restart, so about 4 minutes.
# start-period covers boot, where the heartbeat file is still the previous
# container's.
COPY docker/homelab-healthcheck.sh /opt/hermes/docker/homelab-healthcheck.sh
RUN chmod +x /opt/hermes/docker/homelab-healthcheck.sh && \
    sh -n /opt/hermes/docker/homelab-healthcheck.sh
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=4 \
    CMD ["/opt/hermes/docker/homelab-healthcheck.sh"]
